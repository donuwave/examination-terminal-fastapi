# Пример .env.dev. Файлы .env.dev, .env.prod и .env.test в репозиторий не попадают.

# База для разработки: docker compose up -d db поднимает её на порту 5437.
DATABASE_URL=postgresql+asyncpg://postgres:qwerty@localhost:5437/postgres

# Адреса сайтов, которым разрешён доступ к API, через запятую (необязательно).
# CORS_ORIGINS=http://localhost:5173
