# Пример .env.dev. Файлы .env.dev, .env.prod и .env.test в репозиторий не попадают.

# База для разработки: docker compose up -d db поднимает её на порту 5437.
DATABASE_URL=postgresql+asyncpg://postgres:qwerty@localhost:5437/postgres

# Адреса сайтов, которым разрешён доступ к API, через запятую (необязательно).
# CORS_ORIGINS=http://localhost:5173

# Почта: письма сброса пароля. Без MAIL_HOST письма не отправляются, а пишутся в лог сервера.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=no-reply@example.com
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_FROM_NAME=Экзаменационный терминал
# starttls (порт 587), ssl (порт 465) или none (локальный отладочный сервер)
# MAIL_SECURITY=starttls
