# Скопируйте в .env.prod и заполните. Файл .env.prod в репозиторий не попадает.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=examination

# Порт, на котором API будет доступен снаружи.
API_PORT=8000

# Адреса сайтов, которым разрешён доступ к API, через запятую. Пусто — разрешено всем.
CORS_ORIGINS=
